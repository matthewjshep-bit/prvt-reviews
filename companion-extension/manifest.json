{
  "manifest_version": 3,
  "name": "Shep Flips Companion",
  "version": "1.0.1",
  "description": "Points the Shep Flips companion window at whoever you open in GoHighLevel. Reads GHL tab addresses only, never the page.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.gohighlevel.com/*",
    "https://*.leadconnectorhq.com/*",
    "https://*.shepflips.com/*",
    "https://monumental-biscochitos-35bbee.netlify.app/*",
    "http://localhost:5173/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open the Shep Flips companion window"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.shepflips.com/contact*",
        "https://monumental-biscochitos-35bbee.netlify.app/contact*",
        "http://localhost:5173/contact*"
      ],
      "js": [
        "companion-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
