{
  "name": "shepflips-offer-broker",
  "version": "2.0.0",
  "description": "Backend for the real-estate offer generator: calculates cash/creative offers, renders the offer document via cardgen, and attaches offers to GoHighLevel contact records",
  "type": "module",
  "main": "broker.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node broker.js",
    "test:dataroom": "node dataroom.test.mjs",
    "test:status": "node --test offer-status.test.mjs",
    "test:snapshot": "node --test offer-snapshot.test.mjs",
    "test:offer-page": "node --test offer-page.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "express": "^4.21.2",
    "pdf-lib": "^1.17.1",
    "pg": "^8.13.1"
  }
}
