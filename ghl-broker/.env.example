# --- GoHighLevel ---
# Private Integration token from: sub-account → Settings → Private Integrations
# Scopes needed: contacts.readonly, contacts.write,
#                locations/customFields.readonly, locations/customFields.write,
#                conversations.write, conversations/message.write
# Optional:      conversations.readonly — powers the Dashboard's calls/texts
#                panel; without it the dashboard shows a warning and skips it.
GHL_TOKEN=pit-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# The one sub-account this token belongs to (single-tenant guard).
GHL_LOCATION_ID=PvdeT4y6MyupP0pKMMjz

# Multi-tenant: JSON map of locationId -> Private Integration token, one entry
# per GHL sub-account served by this broker. Each tenant creates their own
# token in their own sub-account (same scopes as above). Entries here win over
# the GHL_TOKEN/GHL_LOCATION_ID pair, which remains as a fallback.
# GHL_TOKENS={"PvdeT4y6MyupP0pKMMjz":"pit-...","AbCdEfGhIjKlMnOpQrSt":"pit-..."}

# Optional per-location access keys: JSON map of locationId -> shared secret.
# When set for a location, every API request must carry it; put it in that
# tenant's GHL custom-menu-link URL as &key=<secret>. Locations without an
# entry are unaffected. Generate with: openssl rand -hex 16
# GHL_LOCATION_KEYS={"AbCdEfGhIjKlMnOpQrSt":"long-random-secret"}

# --- Services ---
# The cardgen render service that draws the offer document (no trailing slash).
CARD_SERVICE_URL=https://cards.prvtmkt.com

# Public URL of THIS broker (used for local-dev document URLs when R2 is unset).
PUBLIC_BASE_URL=https://api.prvtmkt.com

# Only set if the frontends are served from a different origin than this API.
# Comma-separated: the offers site and the standalone Agent Outreach site.
# APP_ORIGIN=https://app.prvtmkt.com,https://agents.prvtmkt.com

# Where generated documents are written when R2 is not configured (dev only).
# UPLOAD_DIR=/data/uploads

PORT=4000

# --- Database (Render-managed Postgres) ---
# Without this, the broker falls back to a local JSON file (dev only).
# Schema is applied automatically on boot (see schema.pg.sql).
DATABASE_URL=postgres://user:pass@host:5432/dbname
# PGSSL=require   # force relaxed SSL; auto-enabled for non-local hosts

# --- Cloudflare R2 (OPTIONAL) ---
# Without these, generated documents are stored in Postgres and served by the
# broker at /api/offers/:id/doc.(pdf|jpg) — zero config, survives deploys.
# Set them to store documents in R2 instead (offloads bandwidth).
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET=cards
R2_PUBLIC_BASE=https://cards.knownintown.com

# --- Send safety ---
# Texting an offer document to a contact only fires when this is "true";
# otherwise every send is forced to a dry run.
# CARD_SENDS_ENABLED=true

# Tag applied to a contact when an offer is created.
# OFFER_TAG=offer-created

# --- Agent Outreach ---
# Bulk-importing listing agents into GHL only writes contacts when this is
# "true"; otherwise every import is forced to a dry run (mirrors
# CARD_SENDS_ENABLED). The RentCast API key itself lives in Settings, not here.
# OUTREACH_IMPORTS_ENABLED=true

# Tag applied to imported agents — a GHL workflow triggered on this tag runs
# the actual outreach texts/emails.
# OUTREACH_TAG=agent-outreach

# --- Dispositions ---
# Bulk-tagging a matched shortlist of investors only writes to GHL when this is
# "true"; otherwise every blast is forced to a dry run (mirrors
# OUTREACH_IMPORTS_ENABLED). Syncing the investor book is read-only and is
# never gated. The Anthropic key used for buy-box search lives in Settings.
# DISPO_BLASTS_ENABLED=true

# Trigger tag applied to a blasted shortlist — a GHL workflow on this tag sends
# the deal out. Each blast also gets its own "<prefix>-<deal>" tag (prefix set
# per location in Settings) so one blast can be targeted without the others.
# DISPO_TAG=dispo-blast

# --- Investor datarooms ---
# Investor links live under PUBLIC_BASE_URL (above) at /d/<token>, so that value
# must be the broker's real public hostname or the texted links won't resolve.
# Texting them reuses CARD_SENDS_ENABLED above — while that is unset, every
# invite send is forced to a dry run.
